# Production environment for docker-compose.prod.yml. Copy to `.env` on the
# server (bootstrap.sh does this and fills the secrets); never commit the copy.
# Every variable below without a default is required: `docker compose
# -f docker-compose.prod.yml config -q` refuses to run until it is set (`-q`
# because plain `config` prints every secret in this file).

# ---- Required ---------------------------------------------------------------

# The public hostname the site answers on. Caddy asks Let's Encrypt for a
# certificate for exactly this name, so it must already resolve to this server.
# With no domain of your own: <ipv4-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io.
# Changing it = edit this line and run deploy/update.sh (a new certificate is
# issued automatically). It also builds the API's CORS_ORIGINS.
SITE_DOMAIN=

# Postgres password for the `budget` role, used by both postgres and the API's
# DATABASE_URL. Hex only — this value is interpolated into a URL, and
# `@ : / % #` in it break DATABASE_URL. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# MinIO root credentials. The API uses the same pair as its S3 access key and
# secret, so changing one of them means changing it here only — but it must be
# changed for both containers in the same edit (they are one variable each).
# Generate the password with: openssl rand -hex 32
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Signing key for session tokens. Rotating it logs every user out immediately.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ---- Optional: AI features --------------------------------------------------

# Without a key the advisor and receipt parsing answer an honest 503
# AI_NOT_CONFIGURED; everything else works.
ANTHROPIC_API_KEY=

# ---- Optional: web push -----------------------------------------------------

# All three or push stays off (GET /push/config -> enabled:false and the daily
# reminder job is a no-op). Rotating the pair kills every existing subscription.
# Generate a pair with (from apps/api):
#   uv run python -c 'from py_vapid import Vapid, b64urlencode; from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat; v = Vapid(); v.generate_keys(); print("VAPID_PUBLIC_KEY=" + b64urlencode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint))); print("VAPID_PRIVATE_KEY=" + b64urlencode(v.private_key.private_numbers().private_value.to_bytes(32, "big")))'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach: mailto:you@example.com
VAPID_SUBJECT=

# ---- Optional: offsite backup copy (Cloudflare R2) --------------------------

# ALL FOUR must be set or none: a partial set is a misconfiguration and
# deploy/backup.sh exits non-zero rather than silently keeping backups local.
# With none of them set, backup.sh still writes local backups and prints a
# WARNING that there is no offsite copy.
#   R2_ENDPOINT          https://<account-id>.r2.cloudflarestorage.com
#   R2_ACCESS_KEY_ID     R2 API token key id (scope: Object Read & Write)
#   R2_SECRET_ACCESS_KEY the token's secret
#   R2_BUCKET            an existing bucket name, e.g. budget-backups
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Defaults you normally leave alone --------------------------------------

# Where backup.sh writes dumps and the receipt mirror (on the host, also bind
# mounted into the `mc` tools container as /backup). Default /var/backups/budget.
# BACKUP_DIR=/var/backups/budget

# Dumps older than this many days are deleted by backup.sh. Default 14.
# BACKUP_RETENTION_DAYS=14

# The base URL the remote MCP connector publishes (issuer, https://<domain>/mcp
# and the two /.well-known/oauth-* documents). DERIVED from SITE_DOMAIN by
# docker-compose.prod.yml — leave it alone in production, and note that an empty
# value switches the connector and its OAuth server OFF entirely. The only reason
# to set it is a local QA stand reached on a non-standard port, where compose
# cannot know the port Caddy publishes:
#   PUBLIC_BASE_URL=https://localhost:8443
# PUBLIC_BASE_URL=

# Published ports. Production keeps the real 80/443 — these exist only so the
# stack can be stood up next to something else (e.g. local verification on
# 8480/8443). Note that Caddy's HTTP->HTTPS redirect always targets 443, so on a
# non-standard port you have to open https://<host>:<CADDY_HTTPS_PORT> directly.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
